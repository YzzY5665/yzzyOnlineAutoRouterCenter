# Port the server listens on (default: 10000)
PORT=10000

# Shared secret clients must send (as the x-api-key header) to call /ask-ai
MY_APP_SECRET=changeme

# API keys per provider. Multiple keys per provider can be pipe-separated
# for key rotation, e.g. GEMINI_KEY=key1|key2|key3
GEMINI_KEY=
GROQ_KEY=
MISTRAL_KEY=
CEREBRAS_KEY=

# Rate limiting for /ask-ai (per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Timeout for each provider call, in milliseconds
PROVIDER_TIMEOUT_MS=15000
